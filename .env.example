# Copy to .env and provide local secrets. Run from the repository root.
# Keep existing private .env values; never include that file in delivery.
DATABASE_PATH=database/ecommerce.db
DICTIONARY_PATH=database/dictionary.json
KNOWLEDGE_PATH=knowledge
RUNTIME_DIR=runtime
DATASET_ROOT=data/c004-r01/baseline
ANCHOR_DATE=2026-11-15
DEMO_MODE=false

# OpenAI-compatible Chat Completions.
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen3.7-flash-2026-07-15
MODEL_API_KEY=
# Verified request settings: temperature=0, enable_thinking=false, stream=false,
# response_format=json_schema. These are provider request fields.
MODEL_TIMEOUT_SECONDS=12
MODEL_MAX_OUTPUT_TOKENS=1024

EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding
EMBEDDING_API_KEY=
# Dimension must match the configured embedding model.
EMBEDDING_DIMENSION=1024

# Dedicated local/Compose pgvector endpoint. Start and ingest explicitly.
# Use this project's dedicated database and port.
VECTOR_BACKEND=pgvector
PG_DSN=postgresql://after_sales_agent:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55435/after_sales_agent
# memory is an explicit volatile component mode and requires ingest before use.
BUSINESS_BASE_URL=http://127.0.0.1:8090
BUSINESS_SERVICE_TOKEN=
# Map private demo bearer -> synthetic actor ID, accepted only when DEMO_MODE=true.
AUTH_TOKENS={}
# Compose-only initialization; use a private URL-safe value and match PG_DSN.
POSTGRES_PASSWORD=

REQUEST_BUDGET_SECONDS=30
HTTP_TIMEOUT_SECONDS=3
HTTP_BUDGET_SECONDS=8
# HTTP_* is the business-tool budget, not a copied 60s generation timeout.
# Model timeout is capped by the trusted remaining task budget when supplied.
